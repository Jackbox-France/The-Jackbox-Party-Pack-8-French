{"fields":[{"t":"B","v":"false","n":"HasIntroAudio"},{"t":"A","v":"intro","n":"IntroAudio"},{"t":"B","v":"true","n":"HasPromptAudio"},{"t":"A","v":"prompt","n":"PromptAudio","s":"Quelles sont les 7 dénominations des pièces de monnaie canadiennes ?"},{"t":"B","v":"true","n":"HasClueAudio0"},{"t":"A","v":"answers_0_hint","n":"ClueAudio0","s":"This one is the smallest coin!"},{"t":"B","v":"true","n":"HasClueAudio1"},{"t":"A","v":"answers_1_hint","n":"ClueAudio1","s":"I'll give this coin a high-five."},{"t":"B","v":"true","n":"HasClueAudio2"},{"t":"A","v":"answers_2_hint","n":"ClueAudio2","s":"Put this coin on a surfboard, because it's hanging ten!"},{"t":"B","v":"true","n":"HasClueAudio3"},{"t":"A","v":"answers_3_hint","n":"ClueAudio3","s":"We're a fourth of the way to THIS coin."},{"t":"B","v":"true","n":"HasClueAudio4"},{"t":"A","v":"answers_4_hint","n":"ClueAudio4","s":"This coin rhymes with the nickname for the one-dollar coin."},{"t":"B","v":"true","n":"HasClueAudio5"},{"t":"A","v":"answers_5_hint","n":"ClueAudio5","s":"This one is named after the bird on it."},{"t":"B","v":"true","n":"HasClueAudio6"},{"t":"A","v":"answers_6_hint","n":"ClueAudio6","s":"Not as much in use, but at least half as fun as a loonie!"},{"t":"B","v":"false","n":"HasFollowupAudio"},{"t":"A","v":"followup","n":"FollowupAudio"},{"t":"B","v":"false","n":"HasOutroAudio"},{"t":"A","v":"outro","n":"OutroAudio"}]}
