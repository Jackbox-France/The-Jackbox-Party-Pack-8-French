{"fields":[{"t":"B","v":"false","n":"HasIntroAudio"},{"t":"A","v":"intro","n":"IntroAudio"},{"t":"B","v":"true","n":"HasPromptAudio"},{"t":"A","v":"prompt","n":"PromptAudio","s":"Vite ! Quels sont les prénoms de tous les membres de One Direction ?"},{"t":"B","v":"true","n":"HasClueAudio0"},{"t":"A","v":"answers_0_hint","n":"ClueAudio0","s":"Sounds like that river in Egypt."},{"t":"B","v":"true","n":"HasClueAudio1"},{"t":"A","v":"answers_1_hint","n":"ClueAudio1","s":"Similar to Billy's last name! Get on the train!"},{"t":"B","v":"true","n":"HasClueAudio2"},{"t":"A","v":"answers_2_hint","n":"ClueAudio2","s":"Shares a name with Mr. Neeson!"},{"t":"B","v":"true","n":"HasClueAudio3"},{"t":"A","v":"answers_3_hint","n":"ClueAudio3","s":"Shares a name with Mr. Potter!"},{"t":"B","v":"true","n":"HasClueAudio4"},{"t":"A","v":"answers_4_hint","n":"ClueAudio4","s":"Like the last name of that fantasy author, C. S. ..."},{"t":"B","v":"true","n":"HasFollowupAudio"},{"t":"A","v":"followup","n":"FollowupAudio","s":"FORMER MEMBERS, I should say. Ugh, don't even start with me."},{"t":"B","v":"true","n":"HasOutroAudio"},{"t":"A","v":"outro","n":"OutroAudio","s":"I'll catch you at the reunion tour, Directioners."}]}
