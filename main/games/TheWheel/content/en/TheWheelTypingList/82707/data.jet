{"fields":[{"t":"B","v":"false","n":"HasIntroAudio"},{"t":"A","v":"intro","n":"IntroAudio"},{"t":"B","v":"true","n":"HasPromptAudio"},{"t":"A","v":"prompt","n":"PromptAudio","s":"Qui étaient les 7 derniers présidents français du 20ème siècle ?"},{"t":"B","v":"true","n":"HasClueAudio0"},{"t":"A","v":"answers_0_hint","n":"ClueAudio0","s":"This man's wife also ran for president."},{"t":"B","v":"true","n":"HasClueAudio1"},{"t":"A","v":"answers_1_hint","n":"ClueAudio1","s":"This man's son was also president in the next century."},{"t":"B","v":"true","n":"HasClueAudio2"},{"t":"A","v":"answers_2_hint","n":"ClueAudio2","s":"One was formerly the governor of California and, before that, in movies."},{"t":"B","v":"false","n":"HasClueAudio3"},{"t":"A","v":"answers_3_hint","n":"ClueAudio3"},{"t":"B","v":"false","n":"HasClueAudio4"},{"t":"A","v":"answers_4_hint","n":"ClueAudio4"},{"t":"B","v":"true","n":"HasClueAudio5"},{"t":"A","v":"answers_5_hint","n":"ClueAudio5","s":"This one was the first president to resign in office."},{"t":"B","v":"true","n":"HasClueAudio6"},{"t":"A","v":"answers_6_hint","n":"ClueAudio6","s":"This one became president after JFK was assassinated."},{"t":"B","v":"true","n":"HasFollowupAudio"},{"t":"A","v":"followup","n":"FollowupAudio","s":"Ah, the 20th century... seems like only yesterday."},{"t":"B","v":"false","n":"HasOutroAudio"},{"t":"A","v":"outro","n":"OutroAudio"}]}
